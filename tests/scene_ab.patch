diff --git a/src/ab.zig b/src/ab.zig
new file mode 100644
index 0000000..d382bf6
--- /dev/null
+++ b/src/ab.zig
@@ -0,0 +1,78 @@
+// MEASUREMENT PATCH, never part of a production build (see tests/scene_ab.py).
+// Applied to a throwaway copy of the tree, it makes one compositor build
+// alternate frames between the legacy and the owned output presenter in blocks
+// of `block` frames, drops the first `warmup` frames of every block, and records
+// per presenter: thread CPU and wall time of the build call, wall time of build
+// plus commit, and GPU elapsed (the timer's generation word carries the tag).
+// Both arms share the process, clocks, thermal and power state, so drift cancels.
+// One summary of `cap` samples per presenter and metric is logged at warn level,
+// as "AB <metric>: legacy mean .. | owned mean .. (ns, n=..)". Selected by
+// REDIWM_TEST_AB, which only a patched build reads.
+const std = @import("std");
+const log = std.log.scoped(.ab);
+
+pub var enabled = false;
+var frame: u64 = 0;
+pub var cur: u1 = 0; // 1 = owned, 0 = legacy
+pub var warm = false;
+pub const mask: u64 = 0x0fff_ffff_ffff_ffff;
+pub const Kind = enum { build_cpu, build_wall, commit_wall, gpu };
+const cap = 3000;
+var samples: [4][2][cap]u32 = undefined;
+var counts = [_][2]usize{.{ 0, 0 }} ** 4;
+var reported = false;
+
+const block = 32;
+const warmup = 6;
+
+/// Call once per frame before the GPU timer begins.
+pub fn advance() void {
+    if (!enabled) return;
+    frame += 1;
+    cur = @intCast((frame / block) % 2);
+    warm = frame % block >= warmup;
+}
+
+/// Build plus commit wall time of a frame that committed.
+pub fn recordCommit(ns: u64) void {
+    if (enabled and warm) record(.commit_wall, cur, ns);
+}
+pub fn tag() u64 {
+    if (!enabled) return 0;
+    return (@as(u64, cur) | (@as(u64, @intFromBool(warm)) << 1)) << 60;
+}
+pub fn threadCpuNs() u64 {
+    var ts: std.posix.timespec = undefined;
+    _ = std.posix.system.clock_gettime(std.posix.CLOCK.THREAD_CPUTIME_ID, &ts);
+    return @as(u64, @intCast(ts.sec)) * 1_000_000_000 + @as(u64, @intCast(ts.nsec));
+}
+pub fn record(kind: Kind, presenter: u1, ns: u64) void {
+    const k = @intFromEnum(kind);
+    const n = &counts[k][presenter];
+    if (n.* >= cap) return;
+    samples[k][presenter][n.*] = @intCast(@min(ns, std.math.maxInt(u32)));
+    n.* += 1;
+    maybeReport();
+}
+fn maybeReport() void {
+    if (reported) return;
+    for (counts) |c| if (c[0] < cap or c[1] < cap) return;
+    reported = true;
+    inline for (.{ .build_cpu, .build_wall, .commit_wall, .gpu }) |kind| {
+        const k = @intFromEnum(@as(Kind, kind));
+        var stat: [2][4]u64 = undefined;
+        for (0..2) |p| {
+            const s = samples[k][p][0..cap];
+            std.mem.sort(u32, s, {}, std.sort.asc(u32));
+            var sum: u64 = 0;
+            for (s) |v| sum += v;
+            stat[p] = .{ sum / cap, s[cap / 2], s[cap / 10], s[cap * 9 / 10] };
+        }
+        log.warn("AB {s}: legacy mean {d} med {d} p10 {d} p90 {d} | owned mean {d} med {d} p10 {d} p90 {d} (ns, n={d})", .{
+            @tagName(@as(Kind, kind)),
+            stat[0][0], stat[0][1], stat[0][2], stat[0][3],
+            stat[1][0], stat[1][1], stat[1][2], stat[1][3],
+            cap,
+        });
+    }
+}
